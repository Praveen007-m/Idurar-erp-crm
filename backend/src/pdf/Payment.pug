doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    style.
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 24px;
        background: #f5f7fa;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
        font-size: 12px;
        line-height: 1.5;
      }

      .page {
        width: 100%;
      }

      .receipt-card {
        width: 100%;
        background: #ffffff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }

      .header {
        width: 100%;
        display: table;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e5e7eb;
      }

      .header-left,
      .header-right {
        display: table-cell;
        vertical-align: top;
        width: 50%;
      }

      .header-right {
        text-align: right;
      }

      .logo {
        max-width: 150px;
        max-height: 64px;
        object-fit: contain;
      }

      .company-name {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 700;
        color: #1890ff;
      }

      .company-meta {
        margin: 0;
        color: #6b7280;
        font-size: 11px;
      }

      .title-bar {
        margin-bottom: 22px;
        padding: 18px 20px;
        background: #f5f7fa;
        border-radius: 14px;
      }

      .title {
        margin: 0 0 6px;
        font-size: 28px;
        font-weight: 700;
        color: #111827;
      }

      .title-sub {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
      }

      .grid {
        width: 100%;
        display: table;
        border-spacing: 0 16px;
      }

      .col {
        display: table-cell;
        vertical-align: top;
        width: 50%;
      }

      .col-left {
        padding-right: 10px;
      }

      .col-right {
        padding-left: 10px;
      }

      .section {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px 20px;
      }

      .section-title {
        margin: 0 0 14px;
        font-size: 14px;
        font-weight: 700;
        color: #1890ff;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }

      .info-table {
        width: 100%;
        border-collapse: collapse;
      }

      .info-table tr + tr td {
        padding-top: 10px;
      }

      .label {
        width: 38%;
        color: #6b7280;
        font-size: 11px;
        vertical-align: top;
      }

      .value {
        width: 62%;
        color: #111827;
        font-size: 12px;
        font-weight: 600;
        text-align: right;
        vertical-align: top;
        word-break: break-word;
      }

      .client-box {
        margin-top: 16px;
      }

      .details-box {
        margin-top: 16px;
      }

      .total-box {
        margin-top: 22px;
        padding: 20px 22px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 16px;
      }

      .total-label {
        margin: 0 0 8px;
        color: #166534;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }

      .total-value {
        margin: 0;
        color: #16a34a;
        font-size: 30px;
        font-weight: 700;
      }

      .footer-note {
        margin-top: 20px;
        text-align: center;
        color: #9ca3af;
        font-size: 11px;
      }

      @page {
        margin: 16mm;
      }
  body
    .page
      .receipt-card
        .header
          .header-left
            if settings.company_logo
              img.logo(src=settings.public_server_file + settings.company_logo)
          .header-right
            h1.company-name #{settings.company_name || '-'}
            p.company-meta #{settings.company_address || '-'}
            p.company-meta #{settings.company_reg_number || '-'}

        .title-bar
          h2.title #{translate('Payment Reciept')}
          p.title-sub #{translate('total paid')} : #{moneyFormatter({amount:model.amount})}

        .grid
          .col.col-left
            .section
              h3.section-title Receipt Info
              table.info-table
                tr
                  td.label #{translate('Date')}
                  td.value #{moment(model.date).format(dateFormat)}
                tr
                  td.label #{translate('Reciept Number')}
                  td.value # #{model.number}/#{model.year || ""}

            .section.client-box
              h3.section-title Client Details
              table.info-table
                tr
                  td.label #{translate('Client')}
                  td.value #{(model.client && model.client.name) || '-'}
                tr
                  td.label Phone
                  td.value #{(model.client && model.client.phone) || '-'}
                tr
                  td.label Email
                  td.value #{(model.client && model.client.email) || '-'}
                tr
                  td.label Address
                  td.value #{(model.client && model.client.address) || '-'}

          .col.col-right
            .section
              h3.section-title Payment Details
              table.info-table
                tr
                  td.label #{translate('Payment Mode')}
                  td.value #{typeof model.paymentMode === 'string' ? model.paymentMode : (model.paymentMode && model.paymentMode.name) || '-'}
                tr
                  td.label #{translate('Reference')}
                  td.value #{model.ref || (model.reference && model.reference._id) || '-'}
                tr
                  td.label #{translate('Description')}
                  td.value #{model.description || '-'}

            .total-box
              p.total-label #{translate('total paid')}
              p.total-value #{moneyFormatter({amount:model.amount})}

        p.footer-note #{settings.company_name || '-'}
